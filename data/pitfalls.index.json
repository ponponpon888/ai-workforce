      "severity": "high"
    },
    {
      "id": "hook-002",
      "kind": "file-content",
      "target": "kit/claude/hooks/guard-sql.mjs",
      "pattern": "fileRouteCandidates",
      "expect": "present",
      "message": "ファイル経由の検出が消えると、psql -f x.sql で書いてから流す2段が再び素通りする。",
      "severity": "high"
    },
    {
      "id": "hook-003",
      "kind": "file-content",
      "target": "kit/claude/hooks/guard-sql.ps1",
      "pattern": "@(Get-FileRouteCandidate",
