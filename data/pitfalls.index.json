      "severity": "low"
    },
    {
      "id": "hook-011",
      "kind": "file-content",
      "target": "kit/claude/hooks/guard-config.mjs",
      "pattern": "function checkSessionStartBaseline()",
      "expect": "present",
      "message": "known-good/settings.jsonとの比較を行うSessionStartの検知本体。これが無くなると、Claude Codeを起動していない間のsettings.json書き換えに気づく手段が無くなる。",
      "severity": "medium"
    },
    {
      "id": "hook-012",
      "kind": "file-content",
      "target": "kit/claude/hooks/guard-sql.mjs",
      "pattern": "DIALECT_FILE_ROUTE_RES",
      "expect": "present",
      "message": "ファイル経路をクライアントごとに分けている定義。1本のパターン一式に戻すと、mysql の -f（--force）を psql の --file として読んで正しいSQLを落とす誤検知が戻る。",
      "severity": "medium"
    },
    {
      "id": "hook-013",
      "kind": "file-content",
      "target": "kit/claude/hooks/guard-config.mjs",
      "pattern": "const OWN_HOME = resolve(dirname(fileURLToPath(import.meta.url)), '..')",
      "expect": "present",
      "message": "guard-config が保護対象の home を自分の位置から導出している行。これを消して環境変数とホームディレクトリだけで決める形に戻すと、標準以外の場所へインストールしたときに実際に使われている設定が無防備に戻る。",
      "severity": "medium"
    },
    {
      "id": "hook-014",
      "kind": "file-content",
      "target": "kit/claude/hooks/guard-config.mjs",
      "pattern": "const INVOKED_HOME = process.argv[1]",
      "expect": "present",
      "message": "Node 版が起動時の綴りからも home を導出している行。これを消すと、シンボリックリンクや 8.3 短縮名を経由して登録された home について、settings.json に書かれている綴り（エージェントが実際に渡してくる綴り）が保護対象から外れる。macOS と Windows の CI が実際にこれで落ちた。PowerShell 版の対応する行は [Environment]::GetCommandLineArgs() を読む箇所。",
      "severity": "medium"
    },
    {
      "id": "hook-015",
      "kind": "file-content",
