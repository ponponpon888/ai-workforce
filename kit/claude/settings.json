{
  "$schema": "https://code.claude.com/schemas/settings.json",

  "//": "AI Workforce - user-level Claude Code settings. See github.com/ponponpon888/ai-workforce",

  "permissions": {
    "defaultMode": "default",
    "disableBypassPermissionsMode": "disable",
    "disableAutoMode": "disable",

    "allow": [
      "Read(**)",
      "Glob(**)",
      "Grep(**)",
      "Bash(pwd)",
      "Bash(ls:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git fetch:*)",
      "Bash(git remote:*)",
      "Bash(npm run build:*)",
      "Bash(npm run lint:*)",
      "Bash(npm test:*)",
      "Bash(npx tsc:*)"
    ],

    "ask": [
      "Bash(npm install:*)",
      "PowerShell(npm install:*)",
      "Bash(npm uninstall:*)",
      "PowerShell(npm uninstall:*)",
      "Bash(git push:*)",
      "PowerShell(git push:*)",
      "Bash(git merge:*)",
      "PowerShell(git merge:*)",
      "Bash(git rebase:*)",
      "PowerShell(git rebase:*)",
      "Bash(vercel:*)",
      "PowerShell(vercel:*)",
      "Bash(supabase:*)",
      "PowerShell(supabase:*)",
      "Bash(curl:*)",
      "PowerShell(Invoke-WebRequest:*)",
      "PowerShell(Invoke-RestMethod:*)",
      "PowerShell(curl.exe:*)"
    ],

    "deny": [
      "Read(.env)",
      "Read(.env.*)",
      "Read(./**/.env)",
      "Read(./**/.env.*)",
      "Read(**/*.pem)",
      "Read(**/id_rsa*)",
      "Read(**/service-account*.json)",
      "Read(./secrets/**)",
      "Read(//**/.ssh/**)",
      "Read(./**/.ssh/**)",
      "Edit(.env)",
      "Edit(.env.*)",
      "Edit(./**/.env)",
      "Edit(./**/.env.*)",

      "Bash(rm -rf:*)",
      "Bash(rm -r:*)",
      "PowerShell(Remove-Item:*)",
      "Bash(git push --force:*)",
      "PowerShell(git push --force:*)",
      "Bash(git push -f:*)",
      "PowerShell(git push -f:*)",
      "Bash(git reset --hard:*)",
      "PowerShell(git reset --hard:*)",
      "Bash(git clean -fd:*)",
      "PowerShell(git clean -fd:*)",
      "Bash(git clean -fdx:*)",
      "PowerShell(git clean -fdx:*)",
      "Bash(git branch -D:*)",
      "PowerShell(git branch -D:*)",
      "Bash(supabase db reset:*)",
      "PowerShell(supabase db reset:*)"
    ]
  },

  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell|mcp__.*[Ss]upabase|mcp__.*[Pp]ostgres|mcp__.*[Nn]eon|mcp__.*[Pp]lanetscale",
        "hooks": [
          {
            "type": "command",
            "command": "{{GUARD_SQL_COMMAND}}",
            "timeout": 15,
            "statusMessage": "guard-sql: checking statement"
          }
        ]
      },
      {
        "//": "Only the shell tools. Read(.env) in deny binds the Read tool alone; cat and Get-Content arrive here instead. No database tool can read a file, so none is matched.",
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "{{GUARD_SECRETS_COMMAND}}",
            "timeout": 15,
            "statusMessage": "guard-secrets: checking for secret files"
          }
        ]
      },
      {
        "//": "Stops the agent from modifying or deleting this kit's own guardrails: settings.json, CLAUDE.md, the hook scripts, and the DDL approval store. See data/pitfalls/hook-006.json for why approvals/ is in scope too.",
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "{{GUARD_CONFIG_COMMAND}}",
            "timeout": 15,
            "statusMessage": "guard-config: checking for self-tamper"
          }
        ]
      },
      {
        "//": "The destructive commands in deny above, in the shapes deny does not match: bash -c / eval / powershell -Command / cmd /c, /bin/rm, sudo / env / npx / find -exec, git -C, rm -rfv, git push origin main --force. Claude Code already splits && ; | and strips timeout/nice/xargs itself. See data/pitfalls/perm-006.json.",
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "{{GUARD_DESTRUCTIVE_COMMAND}}",
            "timeout": 15,
            "statusMessage": "guard-destructive: checking for destructive commands"
          }
        ]
      }
    ],
    "ConfigChange": [
      {
        "//": "Refuses any change to this installed settings.json outright, no matter how it was made. Complements the PreToolUse entry above, which only recognizes the write shapes it was written to pattern-match; this one is Claude Code's own file-change detection and has no such gap for settings.json specifically. Scoped to user_settings only -- it does not reach CLAUDE.md, hooks/, scripts/, or approvals/, which stay on the PreToolUse layer.",
        "matcher": "user_settings",
        "hooks": [
          {
            "type": "command",
            "command": "{{GUARD_CONFIG_COMMAND}}",
            "timeout": 15,
            "statusMessage": "guard-config: checking settings.json change"
          }
        ]
      }
    ]
  }
}
