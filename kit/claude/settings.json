{
  "$schema": "https://code.claude.com/schemas/settings.json",

  "//": "AI Workforce - user-level Claude Code settings. See github.com/ponponpon888/ai-workforce",

  "disableAutoMode": true,

  "permissions": {
    "defaultMode": "ask",
    "disableBypassPermissionsMode": true,

    "allow": [
      "Read(**)",
      "Glob(**)",
      "Grep(**)",
      "Bash(pwd)",
      "Bash(ls *)",
      "Bash(git status *)",
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git diff)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git branch *)",
      "Bash(git branch)",
      "Bash(git fetch *)",
      "Bash(git remote *)",
      "Bash(npm run build *)",
      "Bash(npm run build)",
      "Bash(npm run lint *)",
      "Bash(npm run lint)",
      "Bash(npm test *)",
      "Bash(npm test)",
      "Bash(npx tsc *)"
    ],

    "ask": [
      "Bash(npm install *)",
      "Bash(npm uninstall *)",
      "Bash(git push *)",
      "Bash(git merge *)",
      "Bash(git rebase *)",
      "Bash(vercel *)",
      "Bash(supabase *)",
      "Bash(curl *)",
      "PowerShell(Invoke-WebRequest *)"
    ],

    "deny": [
      "Read(.env)",
      "Read(.env.*)",
      "Read(./**/.env)",
      "Read(./**/.env.*)",
      "Read(**/*.pem)",
      "Read(**/id_rsa*)",
      "Read(**/service-account*.json)",
      "Write(.env)",
      "Write(./**/.env)",
      "Edit(.env)",
      "Edit(./**/.env)",

      "Bash(rm -rf *)",
      "Bash(rm -r *)",
      "PowerShell(Remove-Item -Recurse *)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git reset --hard *)",
      "Bash(git clean -fd *)",
      "Bash(git clean -fdx *)",
      "Bash(git branch -D *)",
      "Bash(supabase db reset *)"
    ]
  },

  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell|mcp__[Ss]upabase__.*|mcp__postgres.*|mcp__neon.*|mcp__planetscale.*",
        "hooks": [
          {
            "type": "command",
            "command": "{{GUARD_SQL_COMMAND}}",
            "timeout": 15,
            "statusMessage": "guard-sql: checking statement"
          }
        ]
      }
    ]
  }
}
